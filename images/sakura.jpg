<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sakuraBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffb6c1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff69b4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#sakuraBg)" />
  <!-- 樱花树 -->
  <path d="M400,600 C400,500 350,400 400,300 C450,400 400,500 400,600 Z" fill="#8B4513" />
  <!-- 樱花花瓣 -->
  <g>
    <path d="M400,300 C450,250 500,300 450,350 C400,300 350,350 400,300 Z" fill="#ffb7c5" opacity="0.9" />
    <path d="M350,280 C400,230 450,280 400,330 C350,280 300,330 350,280 Z" fill="#ffb7c5" opacity="0.8" />
    <path d="M450,280 C500,230 550,280 500,330 C450,280 400,330 450,280 Z" fill="#ffb7c5" opacity="0.8" />
    <path d="M380,250 C430,200 480,250 430,300 C380,250 330,300 380,250 Z" fill="#ffb7c5" opacity="0.7" />
    <path d="M420,250 C470,200 520,250 470,300 C420,250 370,300 420,250 Z" fill="#ffb7c5" opacity="0.7" />
  </g>
  <!-- 飘落的樱花 -->
  <path d="M200,100 C220,90 230,110 210,120 C200,110 190,90 200,100 Z" fill="#ffb7c5" opacity="0.8" />
  <path d="M600,150 C620,140 630,160 610,170 C600,160 590,140 600,150 Z" fill="#ffb7c5" opacity="0.8" />
  <path d="M250,200 C270,190 280,210 260,220 C250,210 240,190 250,200 Z" fill="#ffb7c5" opacity="0.8" />
  <path d="M550,250 C570,240 580,260 560,270 C550,260 540,240 550,250 Z" fill="#ffb7c5" opacity="0.8" />
  <path d="M300,300 C320,290 330,310 310,320 C300,310 290,290 300,300 Z" fill="#ffb7c5" opacity="0.8" />
  <text x="400" y="400" font-family="Arial" font-size="40" font-weight="bold" text-anchor="middle" fill="white" stroke="#ff69b4" stroke-width="2">樱花落尽时</text>
</svg>