<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#000033;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#330066;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#spaceBg)" />
  <!-- 星星 -->
  <g>
    <circle cx="100" cy="100" r="2" fill="white" />
    <circle cx="200" cy="150" r="1.5" fill="white" />
    <circle cx="300" cy="80" r="2" fill="white" />
    <circle cx="400" cy="200" r="1" fill="white" />
    <circle cx="500" cy="120" r="2.5" fill="white" />
    <circle cx="600" cy="180" r="1.5" fill="white" />
    <circle cx="700" cy="100" r="2" fill="white" />
    <circle cx="150" cy="250" r="1.5" fill="white" />
    <circle cx="250" cy="300" r="2" fill="white" />
    <circle cx="350" cy="250" r="1" fill="white" />
    <circle cx="450" cy="350" r="2" fill="white" />
    <circle cx="550" cy="300" r="1.5" fill="white" />
    <circle cx="650" cy="250" r="2" fill="white" />
    <circle cx="750" cy="300" r="1" fill="white" />
    <circle cx="100" cy="400" r="2" fill="white" />
    <circle cx="200" cy="450" r="1.5" fill="white" />
    <circle cx="300" cy="400" r="2" fill="white" />
    <circle cx="400" cy="500" r="1" fill="white" />
    <circle cx="500" cy="450" r="2.5" fill="white" />
    <circle cx="600" cy="500" r="1.5" fill="white" />
    <circle cx="700" cy="400" r="2" fill="white" />
    <circle cx="150" cy="550" r="1.5" fill="white" />
    <circle cx="250" cy="500" r="2" fill="white" />
    <circle cx="350" cy="550" r="1" fill="white" />
    <circle cx="450" cy="450" r="2" fill="white" />
    <circle cx="550" cy="500" r="1.5" fill="white" />
    <circle cx="650" cy="550" r="2" fill="white" />
    <circle cx="750" cy="500" r="1" fill="white" />
  </g>
  <!-- 行星 -->
  <circle cx="600" cy="400" r="50" fill="#0066cc" opacity="0.8" />
  <circle cx="600" cy="400" r="60" fill="#0099ff" opacity="0.3" />
  <circle cx="600" cy="400" r="70" fill="#0099ff" opacity="0.1" />
  <!-- 宇宙飞船 -->
  <g transform="translate(300, 300)">
    <path d="M-20,0 L20,0 L10,-30 L-10,-30 Z" fill="#666666" />
    <path d="M-15,0 L15,0 L10,20 L-10,20 Z" fill="#999999" />
    <circle cx="0" cy="-15" r="5" fill="#ffcc00" />
    <!-- 推进器火焰 -->
    <path d="M-10,20 L10,20 L5,40 L-5,40 Z" fill="#ff6600" />
  </g>
  <!-- 银河 -->
  <path d="M0,100 Q200,50 400,150 T800,200" fill="none" stroke="#9966ff" stroke-width="20" opacity="0.3" />
  <text x="400" y="350" font-family="Arial" font-size="40" font-weight="bold" text-anchor="middle" fill="white" stroke="#ff66cc" stroke-width="2">星际旅人</text>
</svg>